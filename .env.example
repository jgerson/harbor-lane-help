# Copy to .env, fill in, then: set -a; source .env; set +a; streamlit run app.py
# Never commit the real .env (it's in .gitignore).
APP_PASSWORD=choose-one              # required: the app won't open without it
TURBOPUFFER_API_KEY=tpuf_...         # required
ANTHROPIC_API_KEY=sk-ant-...         # optional: written answers and research mode

# Optional overrides (defaults shown)
# TURBOPUFFER_REGION=gcp-us-central1
# TENANT=harbor-lane
# NAMESPACE_PREFIX=hlhelp
# EMBED_MODEL=nvidia/nemotron-3-embed-8b
# EMBED_DIMS=1024
# RERANK_MODEL=zeroentropy/zerank-2
# CLAUDE_MODEL=claude-sonnet-5-5
# QUESTIONS_PER_MINUTE=8
